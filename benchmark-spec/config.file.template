########################################################
# SERVER SIDE configs
########################################################

HOME_DIR=/root/redis
REDIS_PATH=$HOME_PATH/redis-7.2
RDB_PATH=$REDIS_PATH
REDIS_BRANCH=7.2   	#this branch will be installed in case Redis is not already installed in REDIS_PATH
#REDIS_BUILD_FLAGS='REDIS_CFLAGS="-fno-plt" REDIS_LDFLAGS="-fno-plt"'  # if building redis, we can pass build flags
SERVER_SOCKET=0
START_PORT=9000

#SSH
LOGIN_ID=root
SERVER_IP=x.x.x.x
SSH_KEY_PATH=~/.ssh
SSH_KEY_NAME=id_rsa

#irq affinity
SET_IRQ=false
IRQ_INTERFACE="eno1"


########################################################
# CLIENT SIDE configs
########################################################

ITERATION_NUM=3
BENCHSPEC_CONFIG_FILE=$HOME_DIR/redis-scripts/benchmark-spec/test-suite.config
MEMTIER_PATH=$HOME_DIR/memtier_benchmark
LOG_PATH="$HOME_DIR/results-$(date +"%Y%m%d%H%M")"


#######################
# Data Collection Tools
#######################

#install pre-reqs
RUN_BENCH_SPEC=true 

#svr_info
RUN_SVR_INFO=false
SVR_INFO_PATH=/opt/svr-info

#perf
RUN_PERF=false

#flame_graph
RUN_FLAMEGRAPH=false
flamegraph_folder=/root/FlameGraph

#sar
RUN_SAR=false
SAR_DURATION=120

#emon
RUN_EMON=false
EMON_HOME=/opt/intel/emon  # emon path of the Server and client
EMON_FOLDER=$EMON_HOME/bin64  # emon path of the Server and client
EMON_CONFIG_FILE=$HOME_DIR/redis-scripts/pyedp_config.txt

