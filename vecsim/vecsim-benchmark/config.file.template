##############################################################################
# Redis Vector Database Benchmark Configuration Template
##############################################################################
# 
# For detailed benchmarking methodology, HNSW algorithm parameters, and usage
# examples, please refer to README.md
#
##############################################################################

##########################
# Redis Server Settings
##########################
HOME_PATH=$HOME
REDIS_PATH=$HOME_PATH/redis
REDIS_BRANCH=8.2.0   	#this branch will be installed in case Redis is not already installed in REDIS_PATH
VECTOR_SEARCH=redisearch     # set this to either redisearch or vectorsets 
PORT=9000

# NUMA Configuration for Redis server (optional)
# Specify the exact NUMA command to use for Redis server processes
# Examples:
#   NUMA_CONFIG="numactl -N 0,1 -m 0,1"          # Use NUMA nodes 0,1 for memory and CPU
#   NUMA_CONFIG="taskset -c 0-15"                # Use CPU cores 0-15
#   NUMA_CONFIG=""                               # Disable NUMA control (default)
NUMA_CONFIG="numactl -N 0 -m 0"

# Note: For remote servers, the user must have passwordless sudo access
# to install system dependencies 
SERVER_REMOTE=false             # If used with cluster this is the node on which cluster will be created
LOGIN_ID=root                   # Username for SSH connections to remote servers
SERVER_IP=1.2.3.4

##########################
# Redis cluster settings 
##########################
REDIS_CLUSTER=1                # Set value of this variable to 1 to run redis cluster and to 0 to run single instance of redis
CLUSTER_MULTIPLE_SERVERS=0     # Set value of this variable to 1 to use IP's from CLUSTER_SERVERS
CLUSTER_SERVERS=("1.2.3.4" "2.3.4.5" "3.4.5.6")
CLUSTER_NODES=24
CLUSTER_REPLICAS=0
CLUSTER_TIMEOUT=50000

##########################
# RediSearch Settings
##########################
REDISEARCH_WORKERS=1

##########################
# Redis Enterprise settings #
##########################
REDIS_ENTERPRISE=0            # Set value of this variable to 1 to run Redis Enterprise instead of open source
LICENSE_PATH=$HOME_PATH/license.txt
RE_SERVERS=("1.2.3.4" "2.3.4.5" "3.4.5.6") # List of servers that will run RE cluster, first server will be used as master
CLUSTER_MASTER=1.2.3.4 # Ip of cluster master it also need to be listed in RE_SERVERS variable
RE_URL=https://s3.amazonaws.com/redis-enterprise-software-downloads/7.4.2/redislabs-7.4.2-104-focal-amd64.tar
REDISEARCH_URL=https://s3.amazonaws.com/benchmarks.redislabs/internal-tasks/intel/laion-1b/redisearch.Linux-ubuntu20.04-x86_64.2.10.4.zip
RE_USERNAME=readmin@intel.com
RE_PASSWORD=readmin
SHARD_COUNT=20
WORKER_THREADS=5


##########################
# Benchmark settings #
##########################
VECTORDB_BENCHMARK_PATH=$HOME_PATH/vector-db-benchmark
VECTORDB_BENCHMARK_BRANCH=update.redisearch
# Virtual environment will be created at: $HOME_PATH/venv-redis-benchmark
SKIP_UPLOAD=0       # Set SKIP_UPLOAD to 1 to skip both Redis setup and data upload -> run benchmark on existing Redis instance with existing data. Make sure that the same dataset is selected in DATASET_SIZE!

# NUMA Configuration for benchmark client (optional)
# Specify the exact NUMA command to use for benchmark client processes
# Examples:
#   NUMA_CONFIG_CLIENT="numactl -N 0,1 -m 0,1"    # Use NUMA nodes 0,1
#   NUMA_CONFIG_CLIENT="taskset -c 16-31"         # Use CPU cores 16-31
#   NUMA_CONFIG_CLIENT=""                         # Disable NUMA control (default)
NUMA_CONFIG_CLIENT="numactl -N 1 -m 1"

# Choose dataset size for benchmarking vector db, available datasets:
# laion-512-1M, laion-512-10M, laion-512-20M, laion-512-40M, laion-512-100M, laion-512-200M, laion-512-400M, laion-768-1M, dbpedia-1536-1M, cohere-768-1M
# We consume roughtly 6GB of memory capacity per M vectors. 
# To see available experiment configurations, go to vector-db-benchmark/experiments/configurations
DATASET="dbpedia-1536-1M"
EXPERIMENT_CONFIGURATION="dbpedia-cal-hnsw-float16"
REPETITIONS=1
QUERIES=10000

# Choose the parameters of Redis index:
# M -> Number of maximum allowed outgoing edges for each node in the graph in each layer. on layer zero the maximal number of outgoing edges will be 2M
# EF_CONSTRUCTION -> Number of maximum allowed potential outgoing edges candidates for each node in the graph, during the graph building.
# Available combinations: M16 EF128, M32 EF 128, M32 EF256, M32 EF512, M64 EF256, M64 EF512

M=32
EF_CONSTRUCTION=256
PARALLEL=8
EF_SEARCH=128


##########################
# MLC Settings #
##########################
MLC=0                                    # Set to 1 to run MLC before Redis setup, 0 to disable
MLC_PATH=$HOME_PATH/mlc                 # Path where MLC will be downloaded and extracted

##########################
# EMON Settings #
##########################
RUN_EMON=false
EMON_HOME=/opt/intel/emon  # emon path of the Server and client
EMON_FOLDER=$EMON_HOME/bin64  # emon path of the Server and client
EMON_CONFIG_FILE=$HOME_PATH/redis-scripts/pyedp_config.txt

