PYTHON_PATH=/usr/bin/python3
HOME_PATH=/root
VECTORDB_BENCHMARK_PATH=$HOME_PATH/vector-db-benchmark
SKIP_UPLOAD=0       # Set SKIP_UPLOAD to 1 to skip setup of redis and uploading the data -> run benchmark on existing redis instance with existing data. Make sure that the same dataset is selected in DATASET_SIZE!

##########################
# Redis settings #
##########################

REDIS_PATH=$HOME_PATH/redis
REDIS_BRANCH=7.2   	#this branch will be installed in case Redis is not already installed in REDIS_PATH
#REDIS_BUILD_FLAGS='REDIS_CFLAGS="-fno-plt" REDIS_LDFLAGS="-fno-plt"'  # if building redis, we can pass build flags
SERVER_SOCKET=0
PORT=9000

REDISEARCH_PATH=$HOME_PATH/redisearch
REDISEARCH_BRANCH=v2.8.11   #this branch will be installed in case Redisearch is not already installed in REDISEARCH_PATH

##########################
# SSH Settings #
##########################
SERVER_REMOTE=false     # If used with cluster this is the node on which cluster will be created
LOGIN_ID=root
SERVER_IP=1.2.3.4
SSH_KEY_PATH=~/.ssh
SSH_KEY_NAME=id_rsa

##########################
# Redis cluster settings #
##########################
REDIS_CLUSTER=1                # Set value of this variable to 1 to run redis cluster and to 0 to run single instance of redis
CLUSTER_MULTIPLE_SERVERS=0     # Set value of this variable to 1 to use IP's from CLUSTER_SERVERS
CLUSTER_SERVERS=("1.2.3.4" "2.3.4.5" "3.4.5.6")
CLUSTER_NODES=24
CLUSTER_REPLICAS=0
CLUSTER_TIMEOUT=50000


##########################
# Benchmark settings #
##########################
# Choose dataset size for benchmarking vector db, please choose from: 1M, 10M, 20M, 40M, 100M, 200M, 400M
# We consume roughtly 6GB of memory capacity per M vectors. 

DATASET_SIZE="1M"

# Choose the parameters of Redis index:
# M -> Number of maximum allowed outgoing edges for each node in the graph in each layer. on layer zero the maximal number of outgoing edges will be 2M
# EF_CONSTRUCTION -> Number of maximum allowed potential outgoing edges candidates for each node in the graph, during the graph building.
# Available combinations: M16 EF128, M32 EF 128, M32 EF256, M32 EF512, M64 EF256, M64 EF512

M=32
EF_CONSTRUCTION=256

CREATE_DYNAMICALLY=1 # Set value of this variable to 1 to create custom benchmark scenario (from M, EF_CONSTRUCTION, EF_SEARCH and PARALLEL)
# Number of parallel clients
PARALLEL=8
EF_SEARCH=128


##########################
# Notes                  #
##########################
# EF in search params is HNSW ef_search parameter, it controls the number of edges that is explored by algorithm in every level of the graph. 
# The higher ef_search the more the graph will be explored by HNSW and the ‘better’ nearest neighbors should be returned (better precision) but at the cost of search time. 
# Parameter ‘K’ is responsible for how many vectors we want HNSW to return. 
# Vector-db-benchmark sets ‘K’ parameter to the number of searched nearest neighbors during ground-truth generation. 
# In our case vector-db-benchmark sets K to 100 and HNSW returns 100 approximate nearest neighbors 
# because for every test_vector we searched for 100 nearest neighbors in train_vector dataset during ground-truth generation. 
# Then vector-db-benchmark compares returned vectors from HNSW search and the vectors found during ground-truth generation and based on their intersection it calculates precision.




