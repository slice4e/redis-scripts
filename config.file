
ITERATION_NUM=3
HOME_DIR=/home/redis
CONFIG_FILE=$HOME_DIR/redis-scripts/test-suite.config
POST_SCRIPT=$HOME_DIR/redis-scripts/postscripts/post_process.sh

#SSH
LOGIN_ID=root
SERVER_IP=192.168.2.10
SSH_KEY_PATH=~/.ssh
SSH_KEY_NAME=id_rsa

#Server CPU
GOLDENCOVE_CORES="0-15"
GRACEMONT_CORES="16-23"

#Redis Server
REDIS_PATH=/root/redis
RDB_PATH=/root/redis
BIND_SOCKET=0
START_PORT=9000

#Benchmark
LOG_PATH="$HOME_DIR/results-$(date +"%Y%m%d")"

#emon
RUN_EMON=true
EMON_FOLDER=/opt/intel/emon/bin64  # emon path of the Server
EMON_CONFIG_FILE=$HOME_DIR/redis-scripts/pyedp_config.txt
EMON_POST_SCRIPT=$HOME_DIR/redis-scripts/postscripts/emon_process.sh

#flame_graph
flamegraph_folder=/root/FlameGraph

#sar
SAR_DURATION=120

#irq affinity
SET_IRQ=false
IRQ_INTERFACE="ens785f0"
