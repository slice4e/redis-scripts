########################################################
# CLIENT SIDE configs
########################################################

ITERATION_NUM=3
HOME_DIR=/root
CONFIG_FILE=$HOME_DIR/redis-scripts/test-suite.config
POST_SCRIPT=$HOME_DIR/redis-scripts/postscripts/post_process.sh

#SSH
LOGIN_ID=root
SERVER_IP=192.168.2.10
SSH_KEY_PATH=~/.ssh
SSH_KEY_NAME=id_rsa

#Server CPU
GOLDENCOVE_CORES="0-15"
GRACEMONT_CORES="16-23"

#Benchmark
LOG_PATH="$HOME_DIR/results-$(date +"%Y%m%d")"

#irq affinity
SET_IRQ=false
IRQ_INTERFACE="ens785f0"

#######################
# Data Collection Tools
#######################

#svr_info
RUN_SVR_INFO=true
SVR_INFO_PATH=/opt/svr-info

#perf
RUN_PERF=true

#flame_graph
RUN_FLAMEGRAPH=true
flamegraph_folder=/root/FlameGraph

#sar
RUN_SAR=true
SAR_DURATION=120

#emon
RUN_EMON=false
EMON_FOLDER=/opt/intel/emon/bin64  # emon path of the Server and client
EMON_CONFIG_FILE=$HOME_DIR/redis-scripts/pyedp_config.txt
EMON_POST_SCRIPT=$HOME_DIR/redis-scripts/postscripts/emon_process.sh

########################################################
# SERVER SIDE configs
########################################################

#Redis Server
REDIS_BRANCH=7.2-rc2   	#this branch will be installed in case Redis is not already installed in REDIS_PATH
REDIS_PATH=/root/redis
RDB_PATH=/root/redis
BIND_SOCKET=0
START_PORT=9000
