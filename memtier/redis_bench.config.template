########################################################
# SERVER SIDE configs
########################################################
HOME_DIR=/home/$USER/redis
REDIS_PATH=$HOME_DIR/redis-7.2
REDIS_BRANCH=7.2   	# This branch will be installed in case Redis is not already installed in REDIS_PATH
# REDIS_BUILD_FLAGS='REDIS_CFLAGS="-fno-plt" REDIS_LDFLAGS="-fno-plt"'  # if building redis, we can pass build flags
RDB_PATH=$REDIS_PATH
PIN="sub-numa"      # Set this variable to "sub-numa", "cpu", or "core"
NUMA_NODES=0,1      # Use this variable if PIN==sub-numa, provide numa nodes after semicolon (if single numa node use: "NUMA_NODES=0,")
SERVER_SOCKET=0 	  # Use this variable if PIN==cpu, to assign more than one socket, e.g. in the case of SNC, separate by coma: 0,1
SERVER_CORES=""    # Use this variable if PIN==core, comma-separated list of cores for Redis servers, e.g. "0,2,4,6,8,10"
MEMTIER_CORES=""   # Use this variable if PIN==core, comma-separated list of cores for memtier clients, e.g. "1,3,5,7,9,11". Set to "all" to leave memtier client processes unpinned (no CPU/NUMA restriction) so they can use every available core.
START_PORT=9000
NUM_SERVERS=36 # Each Redis server contributes about 20GB of memory capacity. Verify with top

LOGIN_ID=$USER      # SSH user for the server (and any remote clients). Can be a non-root user as long as it has passwordless (NOPASSWD) sudo, since run_all.sh now uses sudo for privileged operations (package installs, THP, sysctl, perf, IRQ pinning) instead of assuming a root login.
SERVER_IP="127.0.0.1"  # replace with the IP address of the server. Using a physical interface is prefered to using localhost. 
SERVER_REMOTE=false # The server and memtier client are on different nodes
SSH_KEY_PATH=~/.ssh
SSH_KEY_NAME=id_rsa

SET_IRQ=false  #set to true to pin IRQ affinity
IRQ_INTERFACE="eno1"	# The network interface of the redis server
IRQ_INTERFACE_MEMTIER="eno1" # The network interface of memtier client (if remote from server) 

########################################################
# CLIENT SIDE configs
########################################################
AUTOTUNE=true
ITERATION_NUM=3
MEMTIER_PATH=$HOME_DIR/memtier_benchmark
MEMTIER_BRANCH=2.0.0
MEMTIER_SOCKET=1 	# To assign more than one socket, e.g. in the case of SNC, separate by coma: 1,2
RESULTS_FOLDER=memtier_$(date +"%Y%m%d%H%M")
RESULTS_PATH=$HOME_DIR/results/${RESULTS_FOLDER}
NUM_FILL_REQ=2000000
#NUM_FILL_REQ=14000000 # approximately 20GB per instance
DATA_SIZE_LIST="128:10,256:15,512:20,1024:30,2048:15,4092:10"
KEY_PATTERN="R:R" # use G:G Gaussian
RATIO="1:10"
BENCHMARK_DURATION=300
MEMTIER_PIPELINE=64
MEMTIER_CLIENTS=2	# This will be ignored if AUTOTUNE is true
MEMTIER_THREADS=2	# This will be ignored if AUTOTUNE is true

########################################################
# MULTI-CLIENT CONFIGURATION (Optional)
########################################################
# Additional memtier client machines (comma-separated IPs)
# Leave empty for single-client mode (default)
# Example: "192.168.1.10,192.168.1.11,192.168.1.12"
# Note: All clients use same LOGIN_ID, SSH_KEY_PATH, SSH_KEY_NAME, 
# MEMTIER_SOCKET, and HOME_DIR as primary client
ADDITIONAL_CLIENT_IPS=""

#######################
# Data Collection Tools
#######################

#install pre-reqs
RUN_BENCH_SPEC=false 

#svr_info
RUN_SVR_INFO=false
SVR_INFO_PATH=/opt/svr-info

#sar
RUN_SAR=false
SAR_DURATION=$(($BENCHMARK_DURATION-5))

#perf
RUN_PERF=false

#flame_graph
RUN_FLAMEGRAPH=false
flamegraph_folder=/home/$USER/FlameGraph

#emon
RUN_EMON=false
EMON_HOME=/opt/intel/emon  # emon path of the Server and client
EMON_FOLDER=$EMON_HOME/bin64  # emon path of the Server and client
EMON_CONFIG_FILE=$HOME_DIR/redis-scripts/pyedp_config.txt
EMON_DURATION=$(($BENCHMARK_DURATION-5)) # emon collection in seconds. Should be shorter than BENCHMARK_DURATION
