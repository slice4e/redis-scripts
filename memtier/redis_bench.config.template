########################################################
# SERVER SIDE configs
########################################################
HOME_DIR=/home/$USER/redis
SERVER_TYPE=redis  # "redis" or "valkey" -- selects which server is installed/started/killed
REDIS_BRANCH=8.10.2   	# Branch/tag to install in case it is not already installed in REDIS_PATH. For SERVER_TYPE=valkey, use a valkey tag/branch, e.g. "8.1"
REDIS_PATH=$HOME_DIR/redis-$REDIS_BRANCH  # one directory per version, so versions install side by side
# REDIS_BUILD_FLAGS='REDIS_CFLAGS="-fno-plt" REDIS_LDFLAGS="-fno-plt"'  # if building redis, we can pass build flags
RDB_PATH=$REDIS_PATH
# Placement: set exactly one of SERVER_NODES / SERVER_CORES (same rule for MEMTIER_NODES / MEMTIER_CORES below).
# Lists accept ranges. Find the NUMA nodes and their vCPUs with: lscpu | grep NUMA
SERVER_NODES=0          # each Redis server is bound to one whole NUMA node, round-robin over the list
#SERVER_CORES=0-31,64-95 # instead: one Redis server per listed vCPU
START_PORT=9000
NUM_SERVERS=36 # Each Redis server contributes about 20GB of memory capacity. Verify with top

LOGIN_ID=$USER      # SSH user for the server (and any remote clients). Can be a non-root user as long as it has passwordless (NOPASSWD) sudo, since run_all.sh now uses sudo for privileged operations (package installs, THP, sysctl, perf, IRQ pinning) instead of assuming a root login.
SERVER_IP="127.0.0.1"  # replace with the IP address of the server. Using a physical interface is prefered to using localhost. 
SERVER_REMOTE=false # The server and memtier client are on different nodes
SSH_KEY_PATH=~/.ssh
SSH_KEY_NAME=id_rsa

SET_IRQ=false  # true: pin the NIC IRQs (NIC found from SERVER_IP) to the server CPUs on the server and to the memtier CPUs on every client; stops irqbalance there

########################################################
# CLIENT SIDE configs
########################################################
AUTOTUNE=true
ITERATION_NUM=3
MEMTIER_BRANCH=2.5.2
MEMTIER_PATH=$HOME_DIR/memtier_benchmark-$MEMTIER_BRANCH  # one directory per version, so versions install side by side
MEMTIER_NODES=1         # each memtier process is bound to one whole NUMA node, round-robin over the list (same on every client)
#MEMTIER_CORES=32-63,96-127 # instead: one memtier process per listed vCPU, or "all" to leave memtier unpinned
RESULTS_FOLDER=memtier_$(date +"%Y%m%d%H%M")
RESULTS_PATH=$HOME_DIR/results/${RESULTS_FOLDER}
NUM_FILL_REQ=10000000
#NUM_FILL_REQ=14000000 # approximately 20GB per instance with the commented-out DATA_SIZE_LIST below
DATA_SIZE_LIST="128:100"
#DATA_SIZE_LIST="128:10,256:15,512:20,1024:30,2048:15,4092:10"
KEY_PATTERN="R:R" # use G:G Gaussian
RATIO="1:10"
BENCHMARK_DURATION=300
MEMTIER_PIPELINE=64
MEMTIER_CLIENTS=2	# This will be ignored if AUTOTUNE is true
MEMTIER_THREADS=2	# This will be ignored if AUTOTUNE is true

########################################################
# MULTI-CLIENT CONFIGURATION (Optional)
########################################################
# Additional memtier client machines (comma-separated IPs)
# Leave empty for single-client mode (default)
# Example: "192.168.1.10,192.168.1.11,192.168.1.12"
# Note: All clients use same LOGIN_ID, SSH_KEY_PATH, SSH_KEY_NAME, 
# MEMTIER_NODES/MEMTIER_CORES, and HOME_DIR as primary client
ADDITIONAL_CLIENT_IPS=""

#######################
# Data Collection Tools
#######################

#install pre-reqs
RUN_BENCH_SPEC=false 

#svr_info
RUN_SVR_INFO=false
SVR_INFO_PATH=/opt/svr-info

#sar
RUN_SAR=false
SAR_DURATION=$(($BENCHMARK_DURATION-5))

#perf (the flame graph is built from the same perf recording)
RUN_PERF=false
PERF_DURATION=$(( BENCHMARK_DURATION-5 < 60 ? BENCHMARK_DURATION-5 : 60 )) # perf collection in seconds: min(BENCHMARK_DURATION-5, 60)

#flame_graph
RUN_FLAMEGRAPH=false
flamegraph_folder=/home/$USER/FlameGraph

#emon
RUN_EMON=false
EMON_HOME=/opt/intel/emon  # emon path of the Server and client
EMON_FOLDER=$EMON_HOME/bin64  # emon path of the Server and client
EMON_CONFIG_FILE=$HOME_DIR/redis-scripts/pyedp_config.txt
EMON_DURATION=$(( BENCHMARK_DURATION-5 < 60 ? BENCHMARK_DURATION-5 : 60 )) # emon collection in seconds: min(BENCHMARK_DURATION-5, 60)
