########################################################
# SERVER SIDE configs
########################################################
HOME_DIR=/home/sdp/martin-memtier
SERVER_TYPE=redis
REDIS_PATH=$HOME_DIR/redis-7.2
REDIS_BRANCH=7.2
RDB_PATH=$REDIS_PATH
PIN="sub-numa"
NUMA_NODES=0,1,2
SERVER_SOCKET=0
SERVER_CORES=""
MEMTIER_CORES=""
START_PORT=9000
NUM_SERVERS=192

LOGIN_ID=sdp
SERVER_IP="192.168.100.11"
SERVER_REMOTE=true
SSH_KEY_PATH=~/.ssh
SSH_KEY_NAME=id_rsa

SET_IRQ=false
IRQ_INTERFACE="ens6np0"
IRQ_INTERFACE_MEMTIER="ens786np0"

########################################################
# CLIENT SIDE configs
########################################################
AUTOTUNE=true
ITERATION_NUM=3
MEMTIER_PATH=$HOME_DIR/memtier_benchmark
MEMTIER_BRANCH=2.0.0
MEMTIER_SOCKET=0
RESULTS_FOLDER=memtier_$(date +"%Y%m%d%H%M")
RESULTS_PATH=$HOME_DIR/results/${RESULTS_FOLDER}
NUM_FILL_REQ=2000000
DATA_SIZE_LIST="128:10,256:15,512:20,1024:30,2048:15,4092:10"
KEY_PATTERN="R:R"
RATIO="1:10"
BENCHMARK_DURATION=300
MEMTIER_PIPELINE=64
MEMTIER_CLIENTS=2
MEMTIER_THREADS=2

########################################################
# MULTI-CLIENT CONFIGURATION
########################################################
ADDITIONAL_CLIENT_IPS="192.168.100.3,192.168.100.4,192.168.100.5,192.168.100.6"

#######################
# Data Collection Tools
#######################
RUN_BENCH_SPEC=false
RUN_SVR_INFO=false
SVR_INFO_PATH=/opt/svr-info
RUN_SAR=false
SAR_DURATION=$(($BENCHMARK_DURATION-5))
RUN_PERF=false
RUN_FLAMEGRAPH=false
flamegraph_folder=/home/$USER/FlameGraph
RUN_EMON=false
EMON_HOME=/opt/intel/emon
EMON_FOLDER=$EMON_HOME/bin64
EMON_CONFIG_FILE=$HOME_DIR/redis-scripts/pyedp_config.txt
EMON_DURATION=$(($BENCHMARK_DURATION-5))
